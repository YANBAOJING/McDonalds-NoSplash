[Argument]

[General]
bypass-tun =
skip-proxy =
real-ip =
dns-server =

[Rule]

[Rewrite]

[Host]

[Script]
http-response ^https?:\/\/api2\.mcd\.cn\/bff\/portal\/home\/splash(?:\?.*)?$ script-path=https://raw.githubusercontent.com/YANBAOJING/McDonalds-NoSplash/main/mcd_nosplash.js,requires-body=true,tag=去开屏广告

[Mitm]
hostname = api2.mcd.cn
