#!name = 麦当劳-去开屏广告
#!desc = 去除麦当劳App启动开屏广告
#!author = BJ
#!system = iOS,iPadOS
#!system_version = 15
#!loon_version = 3.5.1(978)
#!tag = 麦当劳,去广告,开屏
#!type = normal

[Argument]

[General]
bypass-tun =
skip-proxy =
real-ip =
dns-server =

[Rule]

[Rewrite]

[Host]
api2.mcd.cn

[Script]
^https?:\/\/api2\.mcd\.cn\/bff\/portal\/home\/splash(?:\?.*)?$ requires-body=true script-path = https://raw.githubusercontent.com/YANBAOJING/McDonalds-NoSplash/main/mcd_nosplash.js

[Mitm]
